# Football Tracker Live Data - Environment Configuration
# Copy this file to .env and update with your actual values

# === GENERAL SETTINGS ===
NODE_ENV=development
PORT=8000
DEBUG=true

# === DATABASE CONFIGURATION ===
# Neon PostgreSQL (Production)
DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require

# Local PostgreSQL (Development)
LOCAL_DATABASE_URL=postgresql://localhost:5432/football_tracker

# === LIVE DATA SETTINGS ===
# Auto-refresh interval in milliseconds (default: 30000 = 30 seconds)
LIVE_REFRESH_INTERVAL=30000

# Data cache duration in milliseconds (default: 30000 = 30 seconds)
CACHE_DURATION=30000

# Enable/disable live data features
LIVE_DATA_ENABLED=true
AUTO_REFRESH_ENABLED=true

# === CORS PROXY CONFIGURATION ===
# Primary CORS proxy (leave empty to use default rotation)
PRIMARY_CORS_PROXY=

# Custom CORS proxy (if you have your own)
CUSTOM_CORS_PROXY=

# === FOOTBALL DATA API KEYS ===
# Football-Data.org API
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# SportMonks API
SPORTMONKS_API_KEY=your_sportmonks_api_key_here

# API-Football (RapidAPI)
RAPID_API_KEY=your_rapidapi_key_here
RAPID_API_HOST=api-football-v1.p.rapidapi.com

# The Football API
THE_FOOTBALL_API_KEY=your_the_football_api_key_here

# === TOURNAMENT SPECIFIC SETTINGS ===
# UEFA U21 Championship
UEFA_U21_ENABLED=true
UEFA_U21_TIMEZONE=CET

# FIFA Club World Cup
FIFA_CWC_ENABLED=true
FIFA_CWC_TIMEZONE=EDT

# === SCRAPING CONFIGURATION ===
# User agent for web scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Request timeout in milliseconds
REQUEST_TIMEOUT=10000

# Maximum retry attempts
MAX_RETRY_ATTEMPTS=3

# Delay between retries in milliseconds
RETRY_DELAY=5000

# === MONITORING AND LOGGING ===
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable performance monitoring
PERFORMANCE_MONITORING=true

# Health check interval in milliseconds
HEALTH_CHECK_INTERVAL=300000

# === NETLIFY FUNCTIONS CONFIGURATION ===
# Netlify site ID (for deployment)
NETLIFY_SITE_ID=your_netlify_site_id

# Netlify auth token (for deployment)
NETLIFY_AUTH_TOKEN=your_netlify_auth_token

# === SECURITY SETTINGS ===
# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# CORS settings
CORS_ENABLED=true
CORS_ORIGINS=*

# === FEATURE FLAGS ===
# Enable debug panels
DEBUG_PANELS_ENABLED=true

# Enable mock data fallback
MOCK_DATA_FALLBACK=true

# Enable caching
CACHING_ENABLED=true

# Enable background data fetching
BACKGROUND_FETCH_ENABLED=true

# === THIRD-PARTY INTEGRATIONS ===
# Google Analytics (optional)
GA_TRACKING_ID=

# Sentry error tracking (optional)
SENTRY_DSN=

# New Relic monitoring (optional)
NEW_RELIC_LICENSE_KEY=

# === ADVANCED SETTINGS ===
# Custom CSS file path (optional)
CUSTOM_CSS_PATH=

# Custom JavaScript file path (optional)
CUSTOM_JS_PATH=

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=10

# Data source rotation strategy (round_robin, failover, random)
SOURCE_ROTATION_STRATEGY=round_robin

# === DEPLOYMENT SETTINGS ===
# Base URL for production deployment
BASE_URL=https://your-site.netlify.app

# Asset CDN URL (optional)
CDN_URL=

# Static files caching duration in seconds
STATIC_CACHE_DURATION=3600

# === BACKUP CONFIGURATION ===
# Enable data backup to cloud storage
BACKUP_ENABLED=false

# AWS S3 backup settings (if enabled)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# === NOTIFICATION SETTINGS ===
# Email notifications for system alerts
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=admin@yoursite.com

# Slack notifications (optional)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#football-alerts

# === PERFORMANCE TUNING ===
# Enable gzip compression
GZIP_ENABLED=true

# Enable HTTP/2 server push
HTTP2_PUSH_ENABLED=false

# Preload critical resources
PRELOAD_CRITICAL_RESOURCES=true

# === DEVELOPMENT TOOLS ===
# Enable hot reload in development
HOT_RELOAD_ENABLED=true

# Enable source maps
SOURCE_MAPS_ENABLED=true

# Enable development server HTTPS
DEV_HTTPS_ENABLED=false
